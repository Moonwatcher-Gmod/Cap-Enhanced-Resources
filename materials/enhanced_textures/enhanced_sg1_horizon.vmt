"unlitgeneric"
{
	"$basetexture" "enhanced_textures/enhanced_sg1_horizon"
	"$bumpmap"    "sgs/horizon_normal"
	"$dudvmap"     "sgs/horizon_dudv"
	"$surfaceprop" "water"
	"$envmap" ""
	"$envmaptint" "[.1 .1 .2]"
	"$envmapconstrast" "1"
	"$selfillum" "1"
	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$basetexture"
			"animatedtextureframenumvar" "$frame"
			"animatedtextureframerate" 15.00
		}
	}
}
